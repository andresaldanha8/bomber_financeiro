generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROFESSOR
}

enum StudentStatus {
  ATIVO
  INATIVO
}

enum EntryCondition {
  INDIVIDUAL
  DUPLA
  TRIO_MAIS
}

enum StatusMensalidade {
  PENDENTE
  QUITADA
  ATRASADA
  AGUARDANDO_CONFIRMACAO
}

enum FormaPagamento {
  PIX
  DINHEIRO

  @@map("forma_pagamento")
}

enum StatusConfirmacaoPagamento {
  AGUARDANDO
  CONFIRMADO

  @@map("status_confirmacao_pagamento")
}

enum TipoMovimentoCaixa {
  SALDO_INICIAL
  ENTRADA
  SAIDA

  @@map("tipo_movimento_caixa")
}

enum OrigemMovimentoCaixa {
  SALDO_INICIAL
  PAGAMENTO_ALUNO
  DESPESA
  REPASSE_PROFESSOR
  ADIANTAMENTO_PROFESSOR
  ESTORNO
  AJUSTE

  @@map("origem_movimento_caixa")
}

enum DespesaStatus {
  PENDENTE
  PAGA

  @@map("despesa_status")
}

enum RepasseProfessorStatus {
  AGUARDANDO_RECEBIMENTO
  RECEBIMENTO_CONFIRMADO

  @@map("repasse_professor_status")
}

enum AdiantamentoProfessorStatus {
  SOLICITADO
  RECUSADO
  PAGO_AGUARDANDO_CONFIRMACAO
  CONFIRMADO

  @@map("adiantamento_professor_status")
}

enum DespesaCategoria {
  PROFESSORES  @map("Professores")
  ENERGIA      @map("Energia")
  AGUA         @map("Água")
  INTERNET     @map("Internet")
  ALUGUEL      @map("Aluguel")
  MANUTENCAO   @map("Manutenção")
  EQUIPAMENTOS @map("Equipamentos")
  PRODUTOS_MATERIAL @map("Produtos/Material")
  IMPOSTOS_TAXAS    @map("Impostos/Taxas")
  OUTROS       @map("Outros")

  @@map("despesa_categoria")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(PROFESSOR)
  active       Boolean  @default(true)
  avatar       String?
  chavePix     String?

  sessions               Session[]
  studentsCreated        Student[]               @relation("StudentCreatedBy")
  mensalidadesCreated    Mensalidade[]           @relation("MensalidadeCreatedBy")
  activityPeriodsStarted StudentActivityPeriod[] @relation("StudentActivityStartedBy")
  activityPeriodsEnded   StudentActivityPeriod[] @relation("StudentActivityEndedBy")

  pagamentosRegistrados PagamentoAluno[] @relation("PagamentoRegistradoPor")
  pagamentosConfirmados PagamentoAluno[] @relation("PagamentoConfirmadoPor")
  despesasCriadas        Despesa[]         @relation("DespesaCreatedBy")
  despesasPagas          Despesa[]         @relation("DespesaPaidBy")

  repassesRecebidos   RepasseProfessor[] @relation("RepasseProfessorDestinatario")
  repassesRegistrados RepasseProfessor[] @relation("RepasseProfessorRegistradoPor")
  repassesConfirmados RepasseProfessor[] @relation("RepasseProfessorConfirmadoPor")

  adiantamentosRecebidos   AdiantamentoProfessor[] @relation("AdiantamentoProfessorDestinatario")
  adiantamentosAnalisados  AdiantamentoProfessor[] @relation("AdiantamentoProfessorAnalisadoPor")
  adiantamentosRegistrados AdiantamentoProfessor[] @relation("AdiantamentoProfessorRegistradoPor")
  adiantamentosConfirmados AdiantamentoProfessor[] @relation("AdiantamentoProfessorConfirmadoPor")

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  movimentoCaixas MovimentoCaixa[]

  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Student {
  id             String         @id @default(cuid())
  name           String
  phone          String?
  notes          String?
  entryCondition EntryCondition
  dueDay         Int
  entryDate      DateTime
  status         StudentStatus  @default(ATIVO)

  createdById String
  createdBy   User   @relation("StudentCreatedBy", fields: [createdById], references: [id])

  mensalidades    Mensalidade[]           @relation("StudentMensalidades")
  activityPeriods StudentActivityPeriod[] @relation("StudentActivityPeriods")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
  @@index([createdById])
  @@map("students")
}

model Mensalidade {
  id                 String            @id @default(cuid())
  studentId          String
  competencia        DateTime          @db.Date
  valor              Decimal           @db.Decimal(10, 2)
  dataVencimento     DateTime          @db.Date
  isPagamentoInicial Boolean           @default(false)
  diaBaseNaGeracao   Int
  status             StatusMensalidade @default(PENDENTE)
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  student   Student @relation("StudentMensalidades", fields: [studentId], references: [id], onDelete: Restrict)
  createdBy User    @relation("MensalidadeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  pagamentos PagamentoAluno[] @relation("MensalidadePagamentos")

  // Checks e unicidade parcial da mensalidade inicial estão na migration SQL.
  @@unique([studentId, competencia])
  @@index([status, dataVencimento])
  @@index([dataVencimento])
  @@index([competencia])
  @@index([createdById])
  @@map("mensalidades")
}

model StudentActivityPeriod {
  id          String    @id @default(cuid())
  studentId   String
  startedAt   DateTime
  endedAt     DateTime?
  startedById String
  endedById   String?
  createdAt   DateTime  @default(now())

  student   Student @relation("StudentActivityPeriods", fields: [studentId], references: [id], onDelete: Restrict)
  startedBy User    @relation("StudentActivityStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  endedBy   User?   @relation("StudentActivityEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  // Integridade temporal e unicidade do período aberto estão na migration SQL.
  @@index([studentId, startedAt])
  @@index([startedById])
  @@index([endedById])
  @@map("student_activity_periods")
}

model PagamentoAluno {
  id                String                     @id @default(cuid())
  mensalidadeId     String                     @map("mensalidade_id")
  valor             Decimal                    @map("valor") @db.Decimal(10, 2)
  formaPagamento    FormaPagamento             @map("forma_pagamento")
  statusConfirmacao StatusConfirmacaoPagamento @default(AGUARDANDO) @map("status_confirmacao")
  dataPagamento     DateTime                   @map("data_pagamento") @db.Date
  registradoPorId   String                     @map("registrado_por_id")
  confirmadoPorId   String?                    @map("confirmado_por_id")
  confirmadoEm      DateTime?                  @map("confirmado_em")
  observacao        String?                    @map("observacao")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mensalidade   Mensalidade @relation("MensalidadePagamentos", fields: [mensalidadeId], references: [id], onDelete: Restrict)
  registradoPor User        @relation("PagamentoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  confirmadoPor User?       @relation("PagamentoConfirmadoPor", fields: [confirmadoPorId], references: [id], onDelete: Restrict)

  @@index([mensalidadeId])
  @@index([registradoPorId])
  @@index([confirmadoPorId])
  @@map("pagamentos_alunos")
}

model Despesa {
  id            String           @id @default(cuid())
  descricao     String
  categoria     DespesaCategoria
  valor         Decimal          @db.Decimal(10, 2)
  dataDespesa   DateTime         @db.Date @map("data_despesa")
  status        DespesaStatus    @default(PENDENTE)

  criadoPorId   String           @map("criado_por_id")
  criadoPor     User             @relation("DespesaCreatedBy", fields: [criadoPorId], references: [id], onDelete: Restrict)

  createdAt     DateTime         @default(now()) @map("created_at")

  dataPagamento DateTime?        @db.Date @map("data_pagamento")
  formaPagamento String?         @db.VarChar(100) @map("forma_pagamento")

  pagoPorId     String?          @map("pago_por_id")
  pagoPor       User?            @relation("DespesaPaidBy", fields: [pagoPorId], references: [id], onDelete: Restrict)
  pagoEm        DateTime?        @map("pago_em")

  observacao    String?          @map("observacao")

  @@index([status])
  @@index([dataDespesa])
  @@index([dataPagamento])
  @@index([categoria])
  @@map("despesas")
}

model RepasseProfessor {
  id              String                 @id @default(cuid())
  professorId     String                 @map("professor_id")
  competencia     String                 @db.VarChar(7)
  valor           Decimal                @db.Decimal(10, 2)
  dataRepasse     DateTime               @map("data_repasse") @db.Date
  formaPagamento  String                 @map("forma_pagamento") @db.VarChar(100)
  status          RepasseProfessorStatus @default(AGUARDANDO_RECEBIMENTO)
  registradoPorId String                 @map("registrado_por_id")
  registradoEm    DateTime               @default(now()) @map("registrado_em") @db.Timestamptz(3)
  confirmadoPorId String?                @map("confirmado_por_id")
  confirmadoEm    DateTime?              @map("confirmado_em") @db.Timestamptz(3)

  professor     User  @relation("RepasseProfessorDestinatario", fields: [professorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  registradoPor User  @relation("RepasseProfessorRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  confirmadoPor User? @relation("RepasseProfessorConfirmadoPor", fields: [confirmadoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // CHECKs de valor, competencia, forma e consistencia da confirmacao na migration SQL.
  @@index([professorId], map: "idx_repasses_professor")
  @@index([status], map: "idx_repasses_status")
  @@index([dataRepasse], map: "idx_repasses_data_repasse")
  @@index([competencia], map: "idx_repasses_competencia")
  @@index([registradoPorId], map: "idx_repasses_registrado_por")
  @@index([confirmadoPorId], map: "idx_repasses_confirmado_por")
  @@map("repasses_professores")
}

model AdiantamentoProfessor {
  id           String                       @id @default(cuid())
  professorId  String                       @map("professor_id")
  valor        Decimal                      @db.Decimal(10, 2)
  motivo       String?
  status       AdiantamentoProfessorStatus  @default(SOLICITADO)

  analisadoPorId String?   @map("analisado_por_id")
  analisadoEm    DateTime? @map("analisado_em") @db.Timestamptz(3)
  motivoRecusa   String?   @map("motivo_recusa")

  dataPagamento       DateTime? @map("data_pagamento") @db.Date
  formaPagamento      String?   @map("forma_pagamento") @db.VarChar(100)
  registradoPorId     String?   @map("registrado_por_id")
  pagoEm              DateTime? @map("pago_em") @db.Timestamptz(3)
  observacaoPagamento String?   @map("observacao_pagamento")

  confirmadoPorId String?   @map("confirmado_por_id")
  confirmadoEm    DateTime? @map("confirmado_em") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  professor     User  @relation("AdiantamentoProfessorDestinatario", fields: [professorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  analisadoPor  User? @relation("AdiantamentoProfessorAnalisadoPor", fields: [analisadoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  registradoPor User? @relation("AdiantamentoProfessorRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  confirmadoPor User? @relation("AdiantamentoProfessorConfirmadoPor", fields: [confirmadoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // CHECKs de valor, forma, datas e consistencia dos estados estao na migration SQL.
  @@index([professorId], map: "idx_adiantamentos_professor")
  @@index([status], map: "idx_adiantamentos_status")
  @@index([dataPagamento], map: "idx_adiantamentos_data_pagamento")
  @@index([createdAt], map: "idx_adiantamentos_created_at")
  @@map("adiantamentos_professores")
}

model MovimentoCaixa {
  id                String               @id @default(cuid())
  tipo              TipoMovimentoCaixa   @map("tipo")
  valor             Decimal              @map("valor") @db.Decimal(10, 2)
  dataFinanceira    DateTime             @map("data_financeira") @db.Date
  descricao         String?              @map("descricao")
  origem            OrigemMovimentoCaixa @map("origem")
  referenciaId      String?              @map("referencia_id")
  chaveIdempotencia String               @unique @map("chave_idempotencia") @db.VarChar(255)
  criadoPorId       String               @map("criado_por_id")
  criadoPor         User                 @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  observacao        String?              @map("observacao")
  createdAt         DateTime             @default(now()) @map("created_at")

  @@index([dataFinanceira])
  @@index([origem, referenciaId])
  @@index([tipo, dataFinanceira])
  @@map("movimentos_caixa")
}
