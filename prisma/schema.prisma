generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROFESSOR
}

enum StudentStatus {
  ATIVO
  INATIVO
}

enum EntryCondition {
  INDIVIDUAL
  DUPLA
  TRIO_MAIS
}

enum StatusMensalidade {
  PENDENTE
  QUITADA
  ATRASADA
  AGUARDANDO_CONFIRMACAO
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(PROFESSOR)
  active       Boolean  @default(true)
  avatar       String?
  chavePix     String?

  sessions               Session[]
  studentsCreated        Student[]               @relation("StudentCreatedBy")
  mensalidadesCreated    Mensalidade[]           @relation("MensalidadeCreatedBy")
  activityPeriodsStarted StudentActivityPeriod[] @relation("StudentActivityStartedBy")
  activityPeriodsEnded   StudentActivityPeriod[] @relation("StudentActivityEndedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Student {
  id             String         @id @default(cuid())
  name           String
  phone          String?
  notes          String?
  entryCondition EntryCondition
  dueDay         Int
  entryDate      DateTime
  status         StudentStatus  @default(ATIVO)

  createdById String
  createdBy   User   @relation("StudentCreatedBy", fields: [createdById], references: [id])

  mensalidades    Mensalidade[]           @relation("StudentMensalidades")
  activityPeriods StudentActivityPeriod[] @relation("StudentActivityPeriods")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
  @@index([createdById])
  @@map("students")
}

model Mensalidade {
  id                 String            @id @default(cuid())
  studentId          String
  competencia        DateTime          @db.Date
  valor              Decimal           @db.Decimal(10, 2)
  dataVencimento     DateTime          @db.Date
  isPagamentoInicial Boolean           @default(false)
  diaBaseNaGeracao   Int
  status             StatusMensalidade @default(PENDENTE)
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  student   Student @relation("StudentMensalidades", fields: [studentId], references: [id], onDelete: Restrict)
  createdBy User    @relation("MensalidadeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Checks e unicidade parcial da mensalidade inicial estão na migration SQL.
  @@unique([studentId, competencia])
  @@index([status, dataVencimento])
  @@index([dataVencimento])
  @@index([competencia])
  @@index([createdById])
  @@map("mensalidades")
}

model StudentActivityPeriod {
  id          String    @id @default(cuid())
  studentId   String
  startedAt   DateTime
  endedAt     DateTime?
  startedById String
  endedById   String?
  createdAt   DateTime  @default(now())

  student   Student @relation("StudentActivityPeriods", fields: [studentId], references: [id], onDelete: Restrict)
  startedBy User    @relation("StudentActivityStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  endedBy   User?   @relation("StudentActivityEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  // Integridade temporal e unicidade do período aberto estão na migration SQL.
  @@index([studentId, startedAt])
  @@index([startedById])
  @@index([endedById])
  @@map("student_activity_periods")
}
