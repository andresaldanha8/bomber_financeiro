generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROFESSOR
}

enum StudentStatus {
  ATIVO
  INATIVO
}

enum EntryCondition {
  INDIVIDUAL
  DUPLA
  TRIO_MAIS
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(PROFESSOR)
  active       Boolean  @default(true)
  avatar       String?
  chavePix     String?

  sessions        Session[]
  studentsCreated Student[] @relation("StudentCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Student {
  id             String         @id @default(cuid())
  name           String
  phone          String?
  notes          String?
  entryCondition EntryCondition
  dueDay         Int
  entryDate      DateTime
  status         StudentStatus  @default(ATIVO)

  createdById String
  createdBy   User   @relation("StudentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
  @@index([createdById])
  @@map("students")
}
